APP_NAME="Beos Products API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=beos_products
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=array
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=database

RATE_LIMIT_API=60
API_MAX_PAYLOAD_KB=64
CORS_ALLOWED_ORIGINS=http://localhost:3000
API_DOCS_ENABLED=true
API_VERSION=1.0.0
API_TOKEN_TTL_MINUTES=480

# Tokens demo que crea UserSeeder (nunca en producción). Valor del cliente: {id}|{secreto}, p. ej. 1|<DEMO_ADMIN_TOKEN>
